# ── Base de datos (Neon PostgreSQL) ────────────────────────────────
# Crear DB en https://neon.tech (región sa-east-1) y pegar la connection string
DATABASE_URL="postgresql://usuario:password@host/zatiori?sslmode=require"

# ── NextAuth ───────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-clave-larga-y-secreta"
NEXTAUTH_URL="http://localhost:3000"

# ── Seed ───────────────────────────────────────────────────────────
# Contraseña inicial del usuario admin@zatiori.com
ADMIN_PASSWORD="zatiori2026"

# ── Vercel Blob (fotos, Fase 4) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Instagram Graph API (Fase 6) ───────────────────────────────────
# Clave AES-256-GCM (32 bytes hex) para cifrar el token IG en la DB
# Generar con: openssl rand -hex 32
IG_TOKEN_ENCRYPTION_KEY=""
